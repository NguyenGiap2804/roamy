generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  name            String
  avatarUrl       String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  accounts        AuthAccount[]
  refreshTokens   RefreshToken[]
  emailTokens     EmailToken[]
  categories      Category[]
  places          Place[]
  schedules       Schedule[]
  systemEvents    SystemEvent[]
  apiRequestLogs  ApiRequestLog[]
  apiErrorLogs    ApiErrorLog[]
  imageAssets     ImageAsset[]

  @@index([createdAt])
  @@index([lastLoginAt])
}

model AuthAccount {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  deviceId          String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       EmailTokenType
  codeHash   String
  attempts   Int            @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([userId, type, createdAt])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String
  createdAt DateTime @default(now())
  places    Place[]

  @@unique([userId, name])
  @@index([userId])
}

model Place {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  address      String
  priceRange   String
  openingHours String
  phone        String?
  website      String?
  mapsUrl      String?
  note         String?
  imageUrl     String?
  rating       Float
  hasReminder  Boolean    @default(false)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime   @default(now())
  schedules    Schedule[]

  @@index([userId])
  @@index([userId, categoryId])
  @@index([userId, createdAt])
  @@index([userId, rating])
  @@index([categoryId])
  @@index([createdAt])
  @@index([rating])
}

model Schedule {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId     String
  place       Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  time        String
  status      ScheduleStatus @default(UPCOMING)
  hasReminder Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([userId, date])
  @@index([placeId])
  @@index([date])
}

model SystemEvent {
  id           String              @id @default(uuid())
  type         String
  action       String?
  resourceType String?
  resourceId   String?
  screen       String?
  message      String?
  severity     SystemEventSeverity @default(INFO)
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId     String?
  requestId    String?
  metadata     Json?
  occurredAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())

  @@index([createdAt])
  @@index([occurredAt])
  @@index([type])
  @@index([userId])
  @@index([deviceId])
  @@index([resourceType, resourceId])
}

model ApiRequestLog {
  id             String   @id @default(uuid())
  requestId      String   @unique
  method         String
  path           String
  statusCode     Int
  durationMs     Int
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId       String?
  userAgent      String?
  ipAddress      String?
  query          Json?
  responseStatus String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([method])
  @@index([statusCode])
  @@index([userId])
  @@index([deviceId])
}

model ApiErrorLog {
  id         String   @id @default(uuid())
  requestId  String?
  method     String
  path       String
  statusCode Int
  name       String
  message    String
  details    Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode])
  @@index([path])
  @@index([userId])
  @@index([deviceId])
}

model ImageAsset {
  id          String           @id @default(uuid())
  url         String
  storage     ImageStorageKind
  status      ImageAssetStatus @default(SUCCESS)
  mimeType    String?
  sizeBytes   Int?
  originalName String?
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId    String?
  requestId   String?
  errorMessage String?
  createdAt   DateTime         @default(now())

  @@index([createdAt])
  @@index([storage])
  @@index([status])
  @@index([userId])
  @@index([deviceId])
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ScheduleStatus {
  UPCOMING
  DONE
  CANCELLED
}

enum SystemEventSeverity {
  DEBUG
  INFO
  WARN
  ERROR
}

enum ImageStorageKind {
  CLOUDINARY
  LOCAL
  UNCONFIGURED
}

enum ImageAssetStatus {
  SUCCESS
  FAILED
}
