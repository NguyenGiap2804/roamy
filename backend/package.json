{
  "name": "roamy-backend",
  "version": "1.0.0",
  "description": "Roamy Backend API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run build:admin && prisma generate && tsc",
    "build:admin": "npm --prefix admin ci --include=dev && npm --prefix admin run build",
    "postinstall": "prisma generate",
    "start": "node dist/src/server.js",
    "deploy:start": "prisma migrate deploy && node dist/src/server.js",
    "test": "tsx --test test/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "roamy"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "prisma": "^6.19.0",
    "uuid": "^14.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
